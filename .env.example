# Copy to .env and fill in real values. NEVER commit .env.
# Real values live in the team vault — ask, don't guess.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# Port the API listens on
PORT=5000

# Signing secret for auth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Flat centre fee added to every channeling booking (config/billingConfig.js).
# Optional — defaults to 300 if unset.
CENTER_FEE=300

# Browser origins allowed to call this API, comma-separated (no trailing slash).
# Defaults to http://localhost:5173 when unset. Vite has strictPort:false, so if
# 5173 is taken locally add the fallback port here too.
# Production example: https://your-frontend.onrender.com
CORS_ORIGIN=http://localhost:5173

# --- Optional: revenue forecasting (forecast-service/, deployed separately) ---
# Leave unset to disable; /api/reports/forecast then returns 503 and everything else is unaffected.
# FORECAST_SERVICE_URL=http://localhost:8001
# Must match FORECAST_API_KEY set on the forecast service.
# FORECAST_SERVICE_KEY=
# FORECAST_TIMEOUT_MS=20000

# --- Optional: AI financial assistant (Google Gemini). Unset = rule-based answers only. ---
# Get a key at https://aistudio.google.com/apikey. Backend only: never put it in the frontend.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_TIMEOUT_MS=10000

# --- Contact Us form (routes/contactRoutes.js) ---
# Sends via the Brevo (Sendinblue) transactional email API — free tier,
# no SMTP app-password/2FA needed. Sign up at https://www.brevo.com,
# create an API key at Settings > SMTP & API > API Keys.
BREVO_API_KEY=
# Must be an email address verified as a sender in your Brevo account
# (Settings > Senders & IP). Can be the same as CONTACT_RECIPIENT_EMAIL.
BREVO_SENDER_EMAIL=
# Where Contact Us messages are delivered.
CONTACT_RECIPIENT_EMAIL=virajitha.dilshan@gmail.com
